# Firebase (required) – mirror of corsa-next's NEXT_PUBLIC_FIREBASE_* vars
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456

# AppSync (required)
VITE_APPSYNC_ENDPOINT=https://xxxxxxxxxxxxxxx.appsync-api.us-east-1.amazonaws.com/graphql
# For real-time subscriptions (wss://)
VITE_APPSYNC_REALTIME_ENDPOINT=wss://xxxxxxxxxxxxxxx.appsync-realtime-api.us-east-1.amazonaws.com/graphql
# AppSync API key (required by `yarn codegen`)
APPSYNC_API_KEY=your-appsync-api-key

# CDN base URL for user-uploaded images (optional)
VITE_CDN_BASE=https://your-cdn.cloudfront.net

# Build-time debug logging. NOT required for normal builds.
# When set to "true", the bundle logs host-environment diagnostics + failed
# asset loads to the console. Use `yarn deploy:stable:debug` to build+deploy
# it, then `yarn deploy:stable` to redeploy the quiet production bundle and
# switch it back off.
# Can also be toggled per page at runtime:
#   window.__CORSA_EMBED_CONFIG__.debug = false  (disable even in debug build)
#   <script src="bundle.js" data-debug>           (force-enable on one page)
VITE_EMBED_DEBUG=true
